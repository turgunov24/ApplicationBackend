# EditorConfig — barcha editorlar uchun bazaviy sozlamalar
# https://editorconfig.org
root = true

# Barcha fayllar uchun
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

# Markdown fayllar uchun (trailing whitespace muhim bo'lishi mumkin)
[*.md]
trim_trailing_whitespace = false

# Makefile — tab ishlatish shart
[Makefile]
indent_style = tab